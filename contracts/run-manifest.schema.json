{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kimeisele/federation-hq/main/contracts/run-manifest.schema.json",
  "title": "Run Manifest",
  "description": "Pins one scoped repair run: target repository, baseline SHA, the original bounded maintenance request, the coordination Issue reference, exact prompt versions (scout, repair, review, operator) with content hashes, evidence references, and optional Engineering Encyclopedia context pack. Structural validation only; it does not prove semantic truth.",
  "type": "object",
  "required": [
    "kind",
    "run_id",
    "target_repository",
    "baseline_sha",
    "coordination",
    "pipeline_state",
    "prompt_pins",
    "created_at"
  ],
  "properties": {
    "kind": {
      "const": "federation_hq_run_manifest"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "target_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "maintenance_request": {
      "description": "The durable original scope of a LEGACY run (no mission_input). Exactly one of maintenance_request or mission_input must be present. The Scout candidate may clarify it but may not replace or silently broaden it.",
      "type": "object",
      "required": [
        "text",
        "source",
        "created_at"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source": {
          "description": "How the request entered the workflow.",
          "enum": [
            "human_operator",
            "issue",
            "other"
          ]
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "source_reference": {
          "description": "Optional issue URL or other durable reference.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "coordination": {
      "description": "The run's GitHub-native coordination reference: one run maps to exactly one coordination Issue in kimeisele/federation-hq.",
      "type": "object",
      "required": [
        "protocol_version",
        "issue_number",
        "issue_url"
      ],
      "properties": {
        "protocol_version": {
          "const": "0.1.0"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "issue_url": {
          "type": "string",
          "pattern": "^https://github\\.com/kimeisele/federation-hq/issues/[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "pipeline_state": {
      "enum": [
        "requested",
        "scouting",
        "candidate_selected",
        "repair_in_progress",
        "repair_submitted",
        "independent_review",
        "approved",
        "changes_requested",
        "blocked",
        "invalid_candidate"
      ]
    },
    "prompt_pins": {
      "type": "object",
      "required": [
        "scout",
        "repair",
        "review",
        "operator"
      ],
      "properties": {
        "scout": {
          "$ref": "#/$defs/prompt_pin"
        },
        "repair": {
          "$ref": "#/$defs/prompt_pin"
        },
        "review": {
          "$ref": "#/$defs/prompt_pin"
        },
        "operator": {
          "$ref": "#/$defs/prompt_pin"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "engineering_context_pack": {
      "$ref": "#/$defs/context_pack"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "notes": {
      "type": "string"
    },
    "mission_input": {
      "description": "MissionContract-native mission pin (operator@0.3.0). Exactly one of maintenance_request or mission_input must be present. Pins the exact canonical MissionCandidate + MissionContract as committed Federation HQ artifacts plus the point-in-time admission-time Mission Ledger snapshot; the MissionContract is authoritative and is never copied into the manifest.",
      "type": "object",
      "required": [
        "mission_id",
        "candidate",
        "contract",
        "admission_ledger"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "candidate": {
          "$ref": "#/$defs/mission_artifact_pin"
        },
        "contract": {
          "$ref": "#/$defs/mission_artifact_pin"
        },
        "admission_ledger": {
          "$ref": "#/$defs/mission_artifact_pin",
          "description": "Point-in-time Mission Ledger snapshot against which POL-04 admission was decided. Exact repo-relative path (mission/ledger.yaml), exact HQ commit SHA, exact SHA-256 of the ledger bytes; bytes must exist at that commit. Later Ledger mutations must not change historical admission validity."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "prompt_pin": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "scout",
            "repair",
            "review",
            "operator"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sha256": {
          "description": "SHA-256 of the exact UTF-8 prompt file bytes, as released in the prompt registry.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "location"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "test",
            "log",
            "patch",
            "report",
            "pr",
            "commit"
          ]
        },
        "location": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "context_pack": {
      "type": "object",
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "mission_artifact_pin": {
      "type": "object",
      "required": [
        "path",
        "hq_commit_sha",
        "sha256"
      ],
      "properties": {
        "path": {
          "description": "Repository-relative path under missions/<mission-id>/; must not escape the repository.",
          "type": "string"
        },
        "hq_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}