{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kimeisele/federation-hq/main/contracts/repair-candidate.schema.json",
  "title": "Repair Candidate",
  "description": "The single defect or functionality gap selected by the scout for one run. Produced by scout@<version>; consumed by repair@<version>. Structural validation only.",
  "type": "object",
  "required": [
    "kind",
    "candidate_id",
    "run_id",
    "target_repository",
    "baseline_sha",
    "defect_description",
    "selected_by",
    "created_at"
  ],
  "properties": {
    "kind": {
      "const": "federation_hq_repair_candidate"
    },
    "candidate_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "target_repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository_checkout": {
      "description": "Local path of the target repository checkout at the baseline SHA. External to this repository; not subject to path-escape checks.",
      "type": "string"
    },
    "defect_description": {
      "type": "string"
    },
    "baseline_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_locations": {
      "description": "Relative artifact paths inside this run directory or the Federation HQ repository. Must not escape the repository.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_by": {
      "type": "string"
    },
    "engineering_context_pack": {
      "$ref": "#/$defs/context_pack"
    },
    "created_at": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "context_pack": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
